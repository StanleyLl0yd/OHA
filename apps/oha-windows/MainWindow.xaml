<Window
    x:Class="OHA.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="OHA - Optimized Hybrid Archiver">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    <ScrollViewer>
        <StackPanel Padding="32" Spacing="16">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="OHA" />
            <TextBlock Text="Optimized Hybrid Archiver" />
            <TextBlock Text="M0 native prototype: offline byte analysis only. Archive creation and extraction are not implemented."
                       TextWrapping="Wrap" />
            <Button Content="Run local Rust analysis probe" Click="ProbeButton_Click" />
            <TextBlock x:Name="ProbeResult" Text="Ready" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Window>
